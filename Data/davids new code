```{r}

#=== 8. Feature Engineering ===================================================

df <- df %>%
  arrange(county, year) %>%
  group_by(county) %>%
    mutate(
      price_lag        = lag(housing_price),
      growth_rate      = (housing_price - price_lag)/price_lag,
      median_inc_lag   = lag(median_income),
      permits_lag      = lag(permits),
      price_income_ratio = housing_price/median_income,
      log_price        = log(housing_price),
      log_income       = log(median_income)
    ) %>%
  ungroup() %>%
  filter(!is.na(growth_rate))



```


```{r}



#=== 9. Baseline RMSE =========================================================

y        <- df$growth_rate
baseline <- rep(mean(y), length(y))
cat("Baseline RMSE:", round(RMSE(baseline, y),4), "\n")


```

```{r}


#=== 10. Random Forest & CV ===================================================

features <- c(
  "median_inc_lag","nonfamily_income","permits_lag",
  "income_25_44","income_45_64",
  "Income_to_Permits","Price_to_Permits",
  "price_income_ratio","log_price","log_income"
)
set.seed(42)
ctrl     <- trainControl(method="cv", number=5)
rf_growth<- train(
  x = df[features], y = y,
  method="rf", trControl=ctrl, metric="RMSE", tuneLength=3
)
rf_growth$resample %>%
  mutate(Fold=row_number()) %>%
  select(Fold, RMSE) %>%
  knitr::kable(digits=6, caption="RF CV RMSE for Growth")


```


```{R}



#=== 11. Feature Importances =================================================

imp_g <- varImp(rf_growth)$importance %>%
  rownames_to_column("Feature") %>%
  rename(Importance=Overall) %>%
  arrange(desc(Importance))
imp_g %>% head(10)  # top 10
ggplot(imp_g[1:5,], aes(reorder(Feature, Importance), Importance)) +
  geom_col(fill="darkgreen") + coord_flip() +
  labs(title="Top 5 Growth Predictors", y="Importance")



```



```{r}



years <- sort(unique(df$year))
imp_time <- map_df(years, function(yr){
  sub <- filter(df, year==yr)
  rf  <- randomForest(x=sub[features], y=sub$growth_rate)
  imp <- importance(rf)[,1]
  tibble(Year=yr, Feature=names(imp), Importance=imp)
})

# pick top 5 overall
top_feats <- imp_time %>%
  group_by(Feature) %>%
  summarize(mean_imp=mean(Importance)) %>%
  slice_max(mean_imp, n=5) %>%
  pull(Feature)

imp_time %>%
  filter(Feature %in% top_feats) %>%
  ggplot(aes(x=Year,y=Importance,color=Feature)) +
    geom_line(size=1) + geom_point() +
    labs(title="Top 5 Predictors: Importance Over Time")


```


```{r}


#=== 12. Residual Diagnostics ================================================

df$pred <- predict(rf_growth, df[features])
df$resid<- df$growth_rate - df$pred

ggplot(df, aes(pred, resid)) +
  geom_point(alpha=0.3) + geom_hline(yintercept=0, lty=2) +
  labs("Residuals vs Fitted")

ggplot(df, aes(sample=resid)) +
  stat_qq() + stat_qq_line() +
  labs("QQ‐Plot of Residuals")


```


```{r}


#=== 13. Robustness Checks ===================================================

thr     <- quantile(df$growth_rate, 0.99)
df_sub  <- filter(df, growth_rate < thr)
rf_sub  <- train(x=df_sub[features], y=df_sub$growth_rate,
                 method="rf", trControl=ctrl, metric="RMSE",
                 tuneGrid=rf_growth$bestTune)
cat("RF w/o top1% RMSE:\n")
print(rf_sub$resample %>% select(RMSE))


train_df<- filter(df, year<=2018)
test_df <- filter(df, year>2018)
rf_time <- randomForest(x=train_df[features], y=train_df$growth_rate)
pred_to <- predict(rf_time, test_df[features])
cat("Temporal hold-out RMSE:", RMSE(pred_to, test_df$growth_rate), "\n")


```

